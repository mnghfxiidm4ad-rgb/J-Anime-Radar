# Google Gemini API key (required for daily auto-summaries)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override model. Default tries gemini-1.5-flash then newer Flash models.
GEMINI_MODEL=gemini-1.5-flash

# Public site origin used in canonical URLs, OGP, and JSON-LD
SITE_URL=https://YOUR-USERNAME.github.io/j-anime-radar

# Optional Google Form embed URL for /contact.html
GOOGLE_FORM_EMBED_URL=https://docs.google.com/forms/d/e/1FAIpQLSfqzO3DXp5V8f8FdWfNxgAk_bgJMSXIcMlWHQiFvQkuTMMukA/viewform?embedded=true

# Editorial contact (shown on Contact / About)
CONTACT_EMAIL=editorial@example.com
