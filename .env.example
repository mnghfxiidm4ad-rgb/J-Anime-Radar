# Google Gemini API key (required for daily auto-summaries)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override model. Default tries gemini-flash-latest, then 3.7 and 3.5.
GEMINI_MODEL=gemini-flash-latest

# Rakuten Books application ID for the morning source-sales check
RAKUTEN_APP_ID=
# Optional Rakuten affiliate ID. Item links use affiliateUrl when this is set.
RAKUTEN_AFFILIATE_ID=

# Optional. When set, --generate polishes the Rakuten fact line with this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Public site origin used in canonical URLs, OGP, and JSON-LD
SITE_URL=https://j-animeradar.net

# Optional Google Form embed URL for /contact.html
GOOGLE_FORM_EMBED_URL=https://docs.google.com/forms/d/e/1FAIpQLSfqzO3DXp5V8f8FdWfNxgAk_bgJMSXIcMlWHQiFvQkuTMMukA/viewform?embedded=true

# Editorial contact (shown on Contact / About)
CONTACT_EMAIL=editorial@example.com

# Daily desk: rank-20 episode articles first, then complementary features if short
DAILY_TARGET_COUNT=3
SUPPLEMENT_LOOKBACK_DAYS=30

# Optional WordPress REST mirror (leave blank to skip; static docs/ is canonical)
WP_URL=
WP_USER=
WP_APP_PASSWORD=
WP_STATUS=draft
WP_CATEGORY_EPISODE=
WP_CATEGORY_FEATURE=
WP_TAG_IDS=
WP_GENRE_MEDIA_ACTION=
WP_GENRE_MEDIA_SF=
WP_GENRE_MEDIA_ROMANCE=
WP_GENRE_MEDIA_SLICE_OF_LIFE=
WP_GENRE_MEDIA_COMEDY=
WP_GENRE_MEDIA_FANTASY=
WP_GENRE_MEDIA_DEFAULT=
